# Copy thành deploy/.env.production và chỉ lưu trên máy chủ.
# Không commit file chứa giá trị thật.
APP_DOMAIN=workforce.example.com

POSTGRES_DB=thien_minh_dental
POSTGRES_USER=thien_minh_app
# Dùng chuỗi URL-safe mạnh vì giá trị này cũng được ghép vào DATABASE_URL nội bộ.
POSTGRES_PASSWORD=replace-with-url-safe-random-password
JWT_SECRET=replace-with-at-least-48-random-characters

AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_WEB_SESSION_HOURS=24
AUTH_WEB_IDLE_MINUTES=30
AUTH_MOBILE_SESSION_DAYS=30

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=workforce@example.com
ADMIN_LOGIN_ALERT_EMAILS=

FIREBASE_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
