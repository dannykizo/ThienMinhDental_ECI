{
  "name": "thien-minh-dental-workforce",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:api": "corepack pnpm --dir backend dev",
    "dev:web": "corepack pnpm --dir frontend dev",
    "build": "corepack pnpm -r --if-present build",
    "lint": "corepack pnpm -r --if-present lint",
    "test": "corepack pnpm -r --if-present test",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "infra:up": "docker compose up -d postgres",
    "infra:down": "docker compose down",
    "prod:config": "docker compose --env-file deploy/.env.production -f compose.production.yaml config --quiet",
    "prod:up": "docker compose --env-file deploy/.env.production -f compose.production.yaml up -d --build",
    "prod:down": "docker compose --env-file deploy/.env.production -f compose.production.yaml down",
    "prod:logs": "docker compose --env-file deploy/.env.production -f compose.production.yaml logs -f --tail=200",
    "prod:backup": "sh scripts/prod/backup.sh",
    "prod:bootstrap-admin": "sh scripts/prod/bootstrap-admin.sh"
  }
}
